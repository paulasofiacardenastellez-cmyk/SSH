              "threats": [
                {
                  "id": "502e39e1-4f60-4af4-bc5c-dac0c221b69f",
                  "title": "Ataque de fuerza bruta en credenciales de usuario",
                  "status": "Open",
                  "severity": "High",
                  "type": "Information disclosure / Brecha de información",
                  "description": "Un atacante intenta adivinar contraseñas mediante software automatizado de fuerza bruta",
                  "mitigation": "Implementar bloqueo de cuenta tras varios intentos fallidos y autenticación multifactor (MFA)ión para esta amenaza",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 1,
                  "score": ""
                },
                {
                  "id": "c864579d-4ec0-4cb9-8dc2-c92d77fc31e9",
                  "title": "Suplantación de sesión por robo de tokens JWT",
                  "status": "Open",
                  "severity": "High",
                  "type": "Information disclosure / Brecha de información",
                  "description": "Un atacante intercepta y reutiliza un token de sesión (JWT) no cifrado o almacenado de forma insegura en el navegador.",
                  "mitigation": "Usar tokens con tiempo de expiración corto y almacenarlos en cookies seguras (HttpOnly, Secure, SameSite=Strict)",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 2,
                  "score": ""
                },
                {
                  "id": "8d78b3f1-9bea-4e9d-9215-2e66276d6de6",
                  "title": "Inyección SQL (SQLi) en el formulario de inicio de sesión",
                  "status": "Open",
                  "severity": "Critical",
                  "type": "Tampering / Manipulación",
                  "description": "Inserción de código SQL malicioso en los campos de entrada para alterar la consulta a la base de datos de credenciales",
                  "mitigation": "Uso estricto de consultas parametrizadas (Prepared Statements) y validación de tipos de datos en el servidor",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 3,
                  "score": ""
                },
                {
                  "id": "b92c5473-9a3b-40da-836d-8c5e72eb7677",
                  "title": "Manipulación del payload y algoritmo en tokens JWT",
                  "status": "Open",
                  "severity": "High",
                  "type": "Tampering / Manipulación",
                  "description": "Un usuario malintencionado modifica los datos internos (claims) o el algoritmo de firma de un token para alterar sus permisos",
                  "mitigation": "Validar firmemente la clave secreta y rechazar de forma estricta algoritmos inseguros o el modo none",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 4,
                  "score": ""
                },
                {
                  "id": "e03295ae-7cc4-4816-924a-793ab553a8f7",
                  "title": "Falta de registro de eventos críticos de autenticación",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Denial of service / Denegación de servicio",
                  "description": "Un usuario realiza acciones críticas (como cambios de contraseña o accesos fallidos) sin que queden rastros auditables verificables",
                  "mitigation": "Centralizar y registrar todos los eventos de autenticación en un servidor de logs protegido con sellos de tiempo (NTP)",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 5,
                  "score": ""
                },
                {
                  "id": "1efe68eb-475a-436d-b8e7-743b6f05e218",
                  "title": "Exposición de hashes de contraseñas débiles en la BD",
                  "status": "Open",
                  "severity": "Critical",
                  "type": "Information disclosure / Brecha de información",
                  "description": "Almacenamiento de credenciales utilizando funciones hash obsoletas (como MD5 o SHA1) sin factor de sal (Salt)",
                  "mitigation": "Implementar algoritmos robustos de derivación de claves como Argon2id o bcrypt",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 6,
                  "score": ""
                },
                {
                  "id": "4730a0bd-0388-4ad0-bb00-2ee11852534b",
                  "title": "Fuga de información mediante mensajes de error detallados",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Information disclosure / Brecha de información",
                  "description": "El sistema muestra mensajes de error específicos indicando si un usuario existe o no, facilitando la enumeración de cuentas",
                  "mitigation": "Utilizar mensajes de error genéricos en el inicio de sesión (ej. \"Usuario o contraseña incorrectos\")",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 7,
                  "score": ""
                },
                {
                  "id": "83fe2616-e0b9-44ce-96c9-beec121ff7e4",
                  "title": "Ataque de denegación de servicio (DoS) por saturación de peticiones",
                  "status": "Open",
                  "severity": "High",
                  "type": "Denial of service / Denegación de servicio",
                  "description": "Un atacante envía un volumen masivo de peticiones de inicio de sesión para colapsar los recursos del servidor IAM",
                  "mitigation": "Implementar limitación de tasa de solicitudes (Rate Limiting) y protección mediante WAF o CAPTCHA",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 8,
                  "score": ""
                },
                {
                  "id": "504a4262-be91-4074-8a73-33d5bd28928e",
                  "title": "Escalamiento de privilegios vertical (BOLA / IDOR)",
                  "status": "Open",
                  "severity": "High",
